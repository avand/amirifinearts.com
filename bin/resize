#!/usr/bin/env bash
#
# Make the smaller copies of every image that the pages actually show.
#
#   bin/resize
#
# The photographs in images/ are the originals, most of them 2000-3300px and
# 1-4MB. A painting on a section page is 420px wide; a carousel thumbnail is as
# little as 26px tall. Serving the original to fill those is most of why the
# site was slow to load. So each image gets copies at a few widths, under
#
#   images/sized/<width>/<same path, as .jpg>
#
# and the pages ask for those. The originals stay where they are, untouched;
# they are the only copy of the work at full resolution.
#
# The full-screen view on a section page shows each work at that full
# resolution, and wants it to load *progressively* -- a whole, blurry picture
# first, sharpening as the rest arrives, rather than a picture drawn from the
# top down. Stepping quickly through a section, that is the difference between
# seeing each painting's shape and seeing a strip of it. So each work in
# images/works/ may also get
#
#   images/sized/full/works/<name>.jpg
#
# at its original size:
#
#   a progressive JPEG    nothing -- the original is already what is wanted,
#                         and the page falls back to it.
#   any other JPEG        rewritten as progressive by jpegtran, losslessly:
#                         the same pixels, reordered. Colour profile and
#                         orientation are kept.
#   a PNG                 a progressive JPEG at quality 90, with no colour
#                         subsampling. The one lossy step here, and not a
#                         visible one; PNG cannot load progressively in any
#                         useful way, and these were 500x600 paintings at
#                         1.6MB, where the JPEG is about a tenth of that.
#
# GitHub Pages will not run a plugin that could do this during the build, so
# the copies are made here and committed alongside the originals. bin/dev runs
# this on start and keeps running it, so a photo added while it runs gets its
# copies within a second or two. If one is ever missing, _includes/sized.html
# falls back to the original: the page is slower, never broken.
#
# Every copy is a JPEG, whatever the original was. Several originals are PNGs
# -- 500x600 images at 1.6MB, a format made for flat graphics and wasteful on a
# painting. One of them has a few partly see-through pixels; JPEG cannot keep
# those, so they are filled with the page's grey (#616161), which is what they
# show against today.
#
# Copies are converted to sRGB, the colour space browsers assume, so a photo
# saved with a different colour profile does not shift colour when its profile
# is stripped. Rerunning is cheap: a copy newer than its original is skipped,
# and a copy whose original has gone is removed.

set -euo pipefail
cd "$(dirname "$0")/.."

WIDTHS="240 480 960"
OUT="images/sized"

for tool in vips jpegtran; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    # jpegtran comes with jpeg-turbo, which vips depends on.
    echo "bin/resize needs $tool:  brew install vips" >&2
    exit 1
  fi
done

# An iPhone photo arrives as HEIC, which most browsers cannot show and vips
# cannot read. Say how to convert it rather than silently leaving it out.
find images -type f \( -iname '*.heic' -o -iname '*.heif' \) -not -path "$OUT/*" | while read -r src; do
  echo "  $src is an iPhone photo (HEIC), which browsers cannot show. Convert it:" >&2
  echo "    sips -s format jpeg -s formatOptions 95 \"$src\" --out \"${src%.*}.jpg\" && rm \"$src\"" >&2
done

find images -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) \
  -not -path "$OUT/*" | sort | while read -r src; do
  stem="${src#images/}"
  stem="${stem%.*}"
  for w in $WIDTHS; do
    dest="$OUT/$w/$stem.jpg"
    [ "$dest" -nt "$src" ] && continue
    mkdir -p "$(dirname "$dest")"
    # --height is only there to stop vips treating the width as a bound on the
    # height too. --size down: a 500px original stays 500px at "960", rather
    # than being blown up into a blurrier copy of itself.
    vips thumbnail "$src" "$dest[Q=82,keep=none,background=97,interlace]" "$w" \
      --height 100000 --size down --output-profile srgb
    echo "  sized   $dest"
  done

  case "$src" in images/works/*) ;; *) continue ;; esac
  dest="$OUT/full/$stem.jpg"
  [ "$dest" -nt "$src" ] && continue
  # By what the file is, not what it is called: a few of the originals named
  # .jpg or .jpeg are PNGs inside, as Squarespace handed them over.
  case "$(vipsheader -f vips-loader "$src")" in
    jpegload)
      if [ "$(vipsheader -f jpeg-multiscan "$src" 2>/dev/null)" = "1" ]; then
        rm -f "$dest"   # progressive already; a stale copy would win over it
      else
        mkdir -p "$(dirname "$dest")"
        # Into a temporary name first: a failure would otherwise leave an
        # empty file newer than its original, which every later run would
        # take for a finished copy and skip.
        jpegtran -copy all -progressive -optimize "$src" >"$dest.tmp"
        mv "$dest.tmp" "$dest"
        echo "  full    $dest"
      fi
      ;;
    *)
      mkdir -p "$(dirname "$dest")"
      vips copy "$src" "$dest[Q=90,subsample-mode=off,interlace,background=97]"
      echo "  full    $dest"
      ;;
  esac
done

# Copies of originals that no longer exist.
find "$OUT" -type f -name '*.jpg' 2>/dev/null | while read -r dest; do
  rest="${dest#$OUT/*/}"
  stem="${rest%.jpg}"
  if ! ls "images/$stem".* >/dev/null 2>&1; then
    rm "$dest"
    echo "  removed $dest"
  fi
done
find "$OUT" -type d -empty -delete 2>/dev/null || true
